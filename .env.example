# Required: all chat LLM calls go through Groq
GROQ_API_KEY=
# Required: web-search fallback
TAVILY_API_KEY=

# Optional model overrides (defaults shown)
# GROQ_GRADING_MODEL=openai/gpt-oss-20b
# GROQ_GENERATION_MODEL=openai/gpt-oss-120b
# GROQ_JUDGE_MODEL=openai/gpt-oss-120b

# Embeddings: Groq has no embeddings API.
# "huggingface" (default) runs locally, no key needed. "google" needs GOOGLE_API_KEY.
# Switching provider requires rebuilding the Chroma index.
# EMBEDDING_PROVIDER=huggingface
# HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# GOOGLE_API_KEY=
